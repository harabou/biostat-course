ScriptContainerBox(script("Open(\!r\!t\!"/E:/■■■大学/◎◎滋賀医大/■■講義関連/だい/2021年度/2021_Shiga用/#2/pgm/barely.csv\!",\!r\!tcolumns(\!r\!t\!tNew Column( \!"group\!", Character, \!"Nominal\!" ),\!r\!t\!tNew Column( \!"d_chol\!", Numeric, \!"Continuous\!", Format( \!"Best\!", 12 ) )\!r\!t),\!r\!tImport Settings(\!r\!t\!tEnd Of Line( CRLF, CR, LF ),\!r\!t\!tEnd Of Field( Comma, CSV( 1 ) ),\!r\!t\!tStrip Quotes( 0 ),\!r\!t\!tUse Apostrophe as Quotation Mark( 0 ),\!r\!t\!tUse Regional Settings( 0 ),\!r\!t\!tScan Whole File( 1 ),\!r\!t\!tTreat empty columns as numeric( 0 ),\!r\!t\!tCompressNumericColumns( 0 ),\!r\!t\!tCompressCharacterColumns( 0 ),\!r\!t\!tCompressAllowListCheck( 0 ),\!r\!t\!tLabels( 1 ),\!r\!t\!tColumn Names Start( 1 ),\!r\!t\!tFirst Named Column( 1 ),\!r\!t\!tData Starts( 2 ),\!r\!t\!tLines To Read( \!"All\!" ),\!r\!t\!tYear Rule( \!"20xx\!" )\!r\!t)\!r)"),showlog(true),capture(2),size(728,160),splitterSizes(0.7,0.3),xstretching(1),ystretch("オフ"),))))),
